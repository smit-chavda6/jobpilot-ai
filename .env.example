# ---------------------------------------------------------------------------
# JobPilot AI configuration. Copy to `.env` (`make setup` does this for you).
# Every variable is read by apps/api/app/config.py (pydantic-settings).
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production.
# production forces Secure cookies and refuses the dev mailbox endpoint.
APP_ENV=development

# SQLAlchemy async URL. Local dev without Docker uses SQLite; Compose overrides
# this with postgresql+asyncpg://jobpilot:${POSTGRES_PASSWORD}@postgres:5432/jobpilot
DATABASE_URL=sqlite+aiosqlite:///./var/jobpilot.db

# Docker Compose only: Postgres password and the host port for the web UI.
POSTGRES_PASSWORD=jobpilot
WEB_PORT=8080

# REQUIRED. Secret used to sign access tokens (>= 32 chars).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-dev-only-secret-change-me-dev-only-secret

# REQUIRED. Fernet key for field-level encryption (integration tokens, phone).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=0Q1xKk8m1z6mX3cF4C7xg0bQ7XcH9vR2y5k3oW8sJpU=

# Comma-separated list of browser origins allowed by CORS. The SPA is served same-origin
# (Vite proxy in dev, nginx in Compose), so this only matters for other clients.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Set true behind HTTPS. Forced true when APP_ENV=production.
COOKIE_SECURE=false

# Access token lifetime (minutes) and refresh token lifetime (days).
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Failed logins before temporary lockout, and base lockout (seconds, doubles each time).
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_BASE_SECONDS=60

# AI provider: mock | openai | gemini. mock is deterministic and needs no key.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Timeout (seconds) for one provider call.
LLM_TIMEOUT_SECONDS=30

# Token budgets. When exhausted, AI features degrade to deterministic logic.
AI_DAILY_TOKEN_BUDGET_PER_USER=50000
AI_DAILY_TOKEN_BUDGET_GLOBAL=1000000

# Where uploaded resumes are stored (outside the web root).
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_MB=5

# Run background tasks inline in the API process (true for local dev/tests).
# Compose forces this to false and runs the dedicated worker container (python -m app.worker).
INLINE_TASKS=true

# Analytics: minimum sample size before a rate is shown.
ANALYTICS_MIN_N=20

# Source adapter feature flags (global). Users can also disable per account.
SOURCE_URL_FETCH_ENABLED=true
SOURCE_GREENHOUSE_ENABLED=true
SOURCE_LEVER_ENABLED=true
SOURCE_ASHBY_ENABLED=true
SOURCE_RSS_ENABLED=true

# User-Agent sent when fetching permitted pages / public job-board APIs.
FETCH_USER_AGENT=JobPilotAI/1.0 (+https://github.com/smit-chavda6/jobpilot-ai; personal job-search assistant)
