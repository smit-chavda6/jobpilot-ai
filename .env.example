# ==============================================================================
# JobPilot AI — Environment Configuration
# ==============================================================================

# Application & Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
WEB_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security & Cryptography
# Generate a secure 32+ character string for JWT_SECRET
JWT_SECRET=dev_jwt_secret_must_be_over_32_characters_long_for_security_reasons
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Fernet 32-byte url-safe base64 key for field-level token encryption
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtc2VjcmV0LWtleS1mb3ItZGV2IQ==

# PostgreSQL Database (with pgvector extension)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobpilot
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# Redis (Caching, Queues, Rate Limiting)
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration ('mock', 'gemini', or 'openai')
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_EMBEDDING_MODEL=text-embedding-004
AI_PER_USER_DAILY_TOKEN_LIMIT=50000

# File Upload Hardening
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=10485760 # 10 MB
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,message/rfc822
